{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit:*)",
      "Bash(npm run build)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma format)",
      "Bash(npm ls:*)",
      "Bash(npm outdated:*)",
      "Bash(npm audit)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(vercel:*)",
      "Bash(npx vercel:*)"
    ],
    "deny": [
      "Bash(npx prisma db:*)",
      "Bash(prisma db:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(prisma migrate:*)",
      "Bash(npx prisma studio:*)",
      "Bash(npx prisma studio)",
      "Bash(npm run db:*)",
      "Bash(npx tsx scripts/:*)",
      "Bash(tsx scripts/:*)",
      "Bash(node scripts/:*)",
      "Bash(psql:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_restore:*)",
      "Bash(*--force-reset*)",
      "Bash(*--accept-data-loss*)",
      "Bash(*clear-database*)",
      "Bash(*import-from-mongodb*)",
      "Bash(*TRUNCATE*)",
      "Bash(*DROP TABLE*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
